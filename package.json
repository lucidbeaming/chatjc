{
  "name": "chatjc",
  "version": "1.1.4",
  "description": "MCP for chatbot about a developer's work history and context",
  "license": "Apache-2.0",
  "author": "Joshua Curry (https://github.com/lucidbeaming)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "chat": "tsx scripts/chat-cli.ts",
    "generate-key": "tsx scripts/generate-api-key.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.5.0",
    "@langchain/mistralai": "^1.2.1",
    "@langchain/openai": "^1.8.5",
    "@langchain/textsplitters": "^1.0.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.20",
    "langchain": "^1.6.7",
    "openai": "^6.49.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.9",
    "@types/uuid": "^10.0.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
