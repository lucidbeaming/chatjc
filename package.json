{
  "name": "chatjc",
  "version": "1.1.4",
  "description": "MCP for chatbot about a developer's work history and context",
  "license": "MIT",
  "author": "Joshua Curry (https://github.com/lucidbeaming)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "chat": "tsx scripts/chat-cli.ts",
    "generate-key": "tsx scripts/generate-api-key.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.5.0",
    "@langchain/mistralai": "^1.2.1",
    "@langchain/openai": "^1.8.5",
    "@langchain/textsplitters": "^1.0.2",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "hono": "^4.13.20",
    "langchain": "^1.6.7",
    "openai": "^7.62.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "cheerio": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucidbeaming/chatjc.git"
  },
  "bugs": {
    "url": "https://github.com/lucidbeaming/chatjc/issues"
  },
  "homepage": "https://joshuacurry.dev/chatjc"
}
