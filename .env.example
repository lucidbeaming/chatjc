# Required
API_KEY=your-api-key

# LLM Backend — one of: mistral-langchain, openai-langchain, openai-responses
LLM_BACKEND=mistral-langchain

# Required when LLM_BACKEND=mistral-langchain
MISTRAL_API_KEY=your-mistral-api-key

# Required when LLM_BACKEND=openai-langchain or openai-responses
OPENAI_API_KEY=your-openai-api-key

# Server
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=./data/chatjc.db

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Guardrails
MAX_INPUT_LENGTH=500
MAX_RESPONSE_LENGTH=2000
MAX_RESPONSE_TOKENS=600

# Mistral Models
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# OpenAI Models
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# RAG
CONTEXT_DIR=./context/mock    # Use ./context/live for real data
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
